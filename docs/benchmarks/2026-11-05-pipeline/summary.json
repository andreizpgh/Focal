{
  "date": "2026-11-05",
  "scope": "Exploratory host experiments for the segmentation, confidence, formatting and thread choices of the speech pipeline. Parakeet Ultra INT8 through the sherpa-onnx 2.0.1 Python package, greedy TDT, automatic language, CPU, 2 threads unless stated. Inputs: the 84 FLEURS clips of fleurs-references.json, joined per split and language into continuous streams of 42-85 s in four variants (normal 0.3-0.8 s gaps; pause_stress 0.8-2.5 s gaps of -55 dBFS noise; quiet = normal at gain 0.1; noise_gap 0.5-1.5 s pink-noise gaps). Read speech only; x86_64 host timing is relative and not a phone measurement. Both splits informed the choices, so every figure is in-sample.",
  "scoring": "Same normalisation as scripts/score-wer.py. latency_p50 and finish_to_ready_mean are simulated seconds at a real-time factor of 0.15, not measurements.",
  "policies": {
    "whole": "each stream decoded as one window (comparator only)",
    "focal30": "a replica of the Alpha 9 planner: 30 s windows, 35 s live threshold, low-energy cuts",
    "energy_min6_max20_p500": "relative-energy detector, pause cut at >= 500 ms once a window holds 6 s, hard cut at 20 s",
    "silero_min6_max20_p500": "the same cut rule with Silero VAD flags",
    "silero_min6_max20_p500_rctx": "the same plus 1 s of right context after each pause cut (adopted)"
  },
