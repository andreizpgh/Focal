<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's "New recording" shortcut opens MainActivity, which starts recording. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="record"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_record"
        android:shortcutShortLabel="@string/shortcut_short"
        android:shortcutLongLabel="@string/shortcut_long"
        android:shortcutDisabledMessage="@string/shortcut_disabled">
        <intent
            android:action="app.focal.action.RECORD"
            android:targetPackage="app.focal"
            android:targetClass="app.focal.MainActivity" />
    </shortcut>
</shortcuts>
